---
import type { TripGalleryItem } from '../types/trip';

interface Props {
  gallery: TripGalleryItem[];
  tripTitle: string;
}

const { gallery, tripTitle } = Astro.props;

if (!gallery || gallery.length === 0) {
  return;
}

// Shuffle gallery for randomized display order
function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

// Organize items to avoid holes in the 3-row grid.
// Portrait items span 3 rows (a full column), landscape items span 1 row.
// We group landscapes in multiples of 3 so each column is fully packed,
// and interleave portrait items between groups.
function packGrid(items: TripGalleryItem[]): TripGalleryItem[] {
  const portraits = items.filter(i => (i.orientation || 'landscape') === 'portrait');
  const landscapes = items.filter(i => (i.orientation || 'landscape') !== 'portrait');
  const result: TripGalleryItem[] = [];

  // How many full 3-landscape columns we can make
  const fullColumns = Math.floor(landscapes.length / 3);
  const remainder = landscapes.length % 3;
  let lIdx = 0;

  // Distribute portrait items evenly among landscape column groups
  const portraitInterval = portraits.length > 0 && fullColumns > 0
    ? Math.max(1, Math.floor(fullColumns / (portraits.length + 1)))
    : Infinity;
  let colCount = 0;
  let pIdx = 0;

  // Place full columns of 3 landscapes, inserting portraits at intervals
  for (let c = 0; c < fullColumns; c++) {
    result.push(landscapes[lIdx++], landscapes[lIdx++], landscapes[lIdx++]);
    colCount++;
    if (pIdx < portraits.length && colCount >= portraitInterval) {
      result.push(portraits[pIdx++]);
      colCount = 0;
    }
  }

  // Append remaining portraits
  while (pIdx < portraits.length) {
    result.push(portraits[pIdx++]);
  }

  // Append leftover landscapes (partial column at the end — unavoidable)
  while (lIdx < landscapes.length) {
    result.push(landscapes[lIdx++]);
  }

  return result;
}

// Helper to compute thumbnail path: insert /thumbs/ before the filename
function thumbUrl(imagePath: string): string {
  const lastSlash = imagePath.lastIndexOf('/');
  if (lastSlash === -1) return imagePath;
  return imagePath.substring(0, lastSlash) + '/thumbs' + imagePath.substring(lastSlash);
}

const displayGallery = packGrid(shuffle(gallery));
---

<section class="photo-gallery" aria-label={`${tripTitle} photo gallery`}>
  <h2 class="gallery-title">Gallery</h2>
  <div class="gallery-track">
    {/* First copy of the photo strip */}
    <div class="gallery-grid">
      {displayGallery.map((item, index) => {
        const orientation = item.orientation || 'landscape';
        return (
          <button
            class:list={['gallery-thumbnail', `gallery-thumbnail--${orientation}`]}
            data-index={index}
            type="button"
            aria-label={item.title || `${tripTitle} photo ${index + 1}`}
          >
            <img
              src={thumbUrl(item.image)}
              alt={item.title || `${tripTitle} photo ${index + 1}`}
              class="gallery-thumbnail__image"
              loading="lazy"
            />
          </button>
        );
      })}
    </div>
    {/* Duplicate copy for seamless looping */}
    <div class="gallery-grid" aria-hidden="true">
      {displayGallery.map((item) => {
        const orientation = item.orientation || 'landscape';
        return (
          <div
            class:list={['gallery-thumbnail', `gallery-thumbnail--${orientation}`]}
          >
            <img
              src={thumbUrl(item.image)}
              alt=""
              class="gallery-thumbnail__image"
              loading="lazy"
            />
          </div>
        );
      })}
    </div>
  </div>

  {/* Lightbox Modal */}
  <div
    class="lightbox"
    id="gallery-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label={`${tripTitle} photo viewer`}
    hidden
  >
    <div class="lightbox__backdrop"></div>
    <div class="lightbox__content">
      <button
        class="lightbox__close"
        type="button"
        aria-label="Close photo viewer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <button
        class="lightbox__nav lightbox__nav--prev"
        type="button"
        aria-label="Previous photo"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox__image-container">
        <img
          class="lightbox__image"
          id="lightbox-image"
          src=""
          alt=""
        />
      </div>

      <button
        class="lightbox__nav lightbox__nav--next"
        type="button"
        aria-label="Next photo"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="lightbox__meta" id="lightbox-meta">
        <p class="lightbox__date" id="lightbox-date" hidden></p>
        <p class="lightbox__location" id="lightbox-location" hidden></p>
        <p class="lightbox__description" id="lightbox-description" hidden></p>
      </div>
    </div>
  </div>

  {/* Gallery data for lightbox JS */}
  <script
    is:inline
    type="application/json"
    id="gallery-data"
    set:html={JSON.stringify(displayGallery.map((item) => ({
      image: item.image,
      title: item.title || '',
      description: item.description || '',
      date: item.date || '',
      location: item.location || '',
    })))}
  />
</section>

<script>
  const dataEl = document.getElementById('gallery-data');
  const galleryData = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxDate = document.getElementById('lightbox-date');
  const lightboxLocation = document.getElementById('lightbox-location');
  const lightboxDescription = document.getElementById('lightbox-description');
  const closeBtn = lightbox?.querySelector('.lightbox__close') as HTMLButtonElement | null;
  const prevBtn = lightbox?.querySelector('.lightbox__nav--prev') as HTMLButtonElement | null;
  const nextBtn = lightbox?.querySelector('.lightbox__nav--next') as HTMLButtonElement | null;
  const backdrop = lightbox?.querySelector('.lightbox__backdrop') as HTMLElement | null;
  const thumbnails = document.querySelectorAll<HTMLButtonElement>('button.gallery-thumbnail[data-index]');

  let currentIndex = 0;
  let triggerElement: HTMLElement | null = null;

  function showItem(index: number) {
    const item = galleryData[index];
    if (!item || !lightboxImage) return;

    currentIndex = index;
    lightboxImage.src = item.image;
    lightboxImage.alt = item.title || '';

    if (lightboxDate) {
      lightboxDate.textContent = item.date;
      lightboxDate.hidden = !item.date;
    }
    if (lightboxLocation) {
      lightboxLocation.textContent = item.location;
      lightboxLocation.hidden = !item.location;
    }
    if (lightboxDescription) {
      lightboxDescription.textContent = item.description;
      lightboxDescription.hidden = !item.description;
    }
  }

  function openLightbox(index: number, trigger: HTMLElement) {
    triggerElement = trigger;
    showItem(index);
    if (lightbox) {
      lightbox.hidden = false;
      lightbox.classList.add('is-open');
    }
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.remove('is-open');
      lightbox.hidden = true;
    }
    document.body.style.overflow = '';
    if (triggerElement) {
      triggerElement.focus();
      triggerElement = null;
    }
  }

  function navigate(direction: number) {
    const len = galleryData.length;
    if (len <= 1) return;
    const next = (currentIndex + direction + len) % len;
    showItem(next);
  }

  // Thumbnail clicks
  thumbnails.forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = parseInt(btn.dataset.index || '0', 10);
      openLightbox(index, btn);
    });
  });

  // Close button
  closeBtn?.addEventListener('click', closeLightbox);

  // Backdrop click
  backdrop?.addEventListener('click', closeLightbox);

  // Prev / Next buttons
  prevBtn?.addEventListener('click', () => navigate(-1));
  nextBtn?.addEventListener('click', () => navigate(1));

  // Keyboard handling
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;

    switch (e.key) {
      case 'Escape':
        closeLightbox();
        break;
      case 'ArrowLeft':
        navigate(-1);
        break;
      case 'ArrowRight':
        navigate(1);
        break;
    }
  });
</script>

<style>
  .photo-gallery {
    overflow: hidden;
    width: 100%;
    padding: 2rem 0;
  }

  .gallery-title {
    text-align: center;
    font-size: 2rem;
    font-weight: bold;
    margin: 0 0 2rem 0;
    color: light-dark(#2c3e50, #fff);
  }

  .gallery-track {
    display: flex;
    gap: 8px;
    width: max-content;
    animation: gallery-scroll 60s linear infinite;
  }

  .photo-gallery:hover .gallery-track {
    animation-play-state: paused;
  }

  @keyframes gallery-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 4px)); /* half the track width minus half the gap */
    }
  }

  .gallery-grid {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 200px;
    gap: 8px;
    height: 376px; /* 3 * 120px rows + 2 * 8px gaps */
  }

  .gallery-thumbnail {
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    overflow: hidden;
    border-radius: 4px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .gallery-thumbnail:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    z-index: 1;
  }

  .gallery-thumbnail--portrait {
    grid-row: span 3;
  }

  .gallery-thumbnail--landscape {
    grid-row: span 1;
  }

  .gallery-thumbnail__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Lightbox styles */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    display: flex;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
  }

  .lightbox__content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 3rem;
    gap: 1rem;
  }

  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .lightbox__close:hover,
  .lightbox__close:focus-visible {
    background: rgba(255, 255, 255, 0.3);
  }

  .lightbox__nav {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
    z-index: 1;
  }

  .lightbox__nav:hover,
  .lightbox__nav:focus-visible {
    background: rgba(255, 255, 255, 0.3);
  }

  .lightbox__image-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: calc(100vh - 10rem);
    overflow: hidden;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: calc(100vh - 10rem);
    object-fit: contain;
    border-radius: 4px;
  }

  .lightbox__meta {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    padding: 0.75rem 1.5rem;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    color: #fff;
    font-size: 0.875rem;
    max-width: 90%;
    text-align: center;
  }

  .lightbox__meta p {
    margin: 0;
  }

  .lightbox__date::before {
    content: '📅 ';
  }

  .lightbox__location::before {
    content: '📍 ';
  }

  .lightbox__description {
    width: 100%;
    opacity: 0.85;
  }

  /* Responsive: mobile viewports below 768px */
  @media (max-width: 767px) {
    .photo-gallery {
      padding: 1rem 0;
      touch-action: pan-x pan-y;
      -webkit-overflow-scrolling: touch;
    }

    .gallery-grid {
      grid-auto-columns: 140px;
      height: 264px; /* 3 * 80px rows + 2 * 12px gaps */
      gap: 6px;
    }

    .gallery-track {
      gap: 6px;
    }

    .lightbox__content {
      padding: 1rem;
      flex-direction: column;
    }

    .lightbox__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
    }

    .lightbox__nav--prev {
      left: 0.5rem;
    }

    .lightbox__nav--next {
      right: 0.5rem;
    }

    .lightbox__image-container {
      max-height: calc(100vh - 12rem);
    }

    .lightbox__image {
      max-height: calc(100vh - 12rem);
    }

    .lightbox__meta {
      bottom: 1rem;
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }

    .lightbox__close {
      top: 0.5rem;
      right: 0.5rem;
    }
  }
</style>
